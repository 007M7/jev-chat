# Build
/build/
/app/build/
.gradle/
*.apk
*.ap_
*.dex
*.class
local.properties

# Machine-specific
env.ps1
gradle.properties.local

# IDE
.idea/
*.iml
.vscode/

# Dev artifacts / reports (not part of the product)
/_reports/
/tools/jev/report/
/tools/jev/__pycache__/
**/__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Never commit secrets
*.key
secrets.*

# Prebuilt APK for direct install (tracked on purpose)
!/apk/*.apk

# Signing material never enters the repo
*.jks
*.keystore
keystore.properties

# iOS 原型输出（含真实聊天截图，禁止入库）
tools/ios-spike/out/

# Windows 原型输出（含真实聊天截图，禁止入库）
tools/win-spike/out/

# 依赖装在 D 盘，不进库
desktop/vendor/

# iOS 原生工程：XcodeGen 生成的产物与构建输出，不入库
ios/*.xcodeproj/
ios/Support/
ios/build/
ios/Payload/
ios/*.ipa

# agent 工作笔记（本机状态，不进公开仓库）
.zcode/

# 本地下载的构建产物
/dist/

# Sideloadly 安装在本目录内（工具，不进仓库）
/Sideloadly/

# iOS 构建时从 tools/jev 拷入的共享配置（不在仓库里存副本）
ios/Resources/

# 标注/核对表输出（含真实聊天摘录，禁止入库）
tools/jev/out/

# 本机私有内容：脱敏映射表（里面是真名，绝不能入库）
local/
