# Build
/build/
/app/build/
.gradle/
*.apk
*.ap_
*.dex
*.class
local.properties

# Machine-specific
env.ps1
gradle.properties.local

# IDE
.idea/
*.iml
.vscode/

# Dev artifacts / reports (not part of the product)
/_reports/
/tools/jev/report/
/tools/jev/__pycache__/
**/__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Never commit secrets
*.key
secrets.*

# Prebuilt APK for direct install (tracked on purpose)
!/apk/*.apk

# Signing material never enters the repo
*.jks
*.keystore
keystore.properties

# iOS 原型输出（含真实聊天截图，禁止入库）
tools/ios-spike/out/

# Windows 原型输出（含真实聊天截图，禁止入库）
tools/win-spike/out/

# 依赖装在 D 盘，不进库
desktop/vendor/

# iOS 原生工程：XcodeGen 生成的产物与构建输出，不入库
ios/*.xcodeproj/
ios/Support/
ios/build/
ios/Payload/
ios/*.ipa

# agent 工作笔记（本机状态，不进公开仓库）
.zcode/

# 本地下载的构建产物
/dist/
